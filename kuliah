                                    <i data-lucide="calendar" class="w-4 h-4"></i>
                                </div>
                                <div>
                                    <h3 class="font-bold text-base sm:text-lg text-slate-900 dark:text-white leading-tight">${dayGroup.day}</h3>
                                    <span class="text-[11px] text-slate-500 dark:text-slate-400 font-medium">${totalItems} Sesi Perkuliahan</span>
                                </div>
                            </div>

                            <div class="flex items-center gap-2.5">
                                <span class="px-2.5 py-1 text-xs font-semibold rounded-full bg-slate-200/60 dark:bg-slate-800 text-slate-600 dark:text-slate-300 border border-slate-300/40 dark:border-slate-700/40 hidden sm:inline-block">
                                    ${totalItems} Sesi
                                </span>
                                <div class="w-7 h-7 rounded-full flex items-center justify-center transition-transform duration-300 ${isOpen ? 'rotate-180 bg-black/5 dark:bg-white/10' : ''}">
                                    <i data-lucide="chevron-down" class="w-4 h-4 text-slate-500 dark:text-slate-400"></i>
                                </div>
                            </div>
                        </button>

                        <!-- Accordion Wrapper (Smooth CSS Animation) -->
                        <div class="accordion-wrapper ${isOpen ? 'open' : ''}">
                            <div class="accordion-inner p-4 sm:p-5 space-y-2.5 bg-slate-50/50 dark:bg-slate-900/30">
                                ${dayGroup.items.map((item) => {
                                    const isExam = item.isExam;
                                    const itemBg = isExam 
                                        ? 'bg-amber-500/10 dark:bg-amber-500/15 border-amber-500/30' 
                                        : 'schedule-item';
                                    
                                    const timeBadge = isLipia 
                                        ? 'bg-blue-50 dark:bg-blue-950/60 text-blue-700 dark:text-sky-300 border border-blue-200/60 dark:border-blue-800/50' 
                                        : 'bg-teal-50 dark:bg-teal-950/60 text-teal-700 dark:text-teal-300 border border-teal-200/60 dark:border-teal-800/50';

                                    return `
                                        <div class="p-3.5 rounded-xl ${itemBg} flex flex-col sm:flex-row sm:items-center justify-between gap-3 shadow-2xs">
                                            <div class="flex items-start sm:items-center gap-3">
                                                <div class="p-2 rounded-lg ${isLipia ? 'bg-lipia-sky/20 text-blue-600 dark:text-sky-400' : 'bg-uim-gold/20 text-amber-600 dark:text-amber-400'} mt-0.5 sm:mt-0 flex-shrink-0">
                                                    <i data-lucide="${item.icon || 'book'}" class="w-4 h-4"></i>
                                                </div>
                                                <div>
                                                    <div class="flex items-center gap-2">
                                                        <span class="text-[11px] font-bold uppercase tracking-wider text-slate-400 dark:text-slate-400">${item.jam}:</span>
                                                        <h4 class="font-bold text-sm sm:text-base text-slate-900 dark:text-slate-100 leading-snug">
                                                            ${item.subject}
                                                        </h4>
                                                        ${isExam ? '<span class="px-2 py-0.5 text-[10px] font-extrabold uppercase bg-amber-500 text-white rounded-md shadow-2xs">Ujian</span>' : ''}
                                                    </div>
                                                    ${item.lecturer ? `
                                                        <p class="text-xs text-slate-500 dark:text-slate-400 mt-1 flex items-center gap-1 font-medium">
                                                            <i data-lucide="user" class="w-3 h-3 text-slate-400"></i> Pengajar: ${item.lecturer}
                                                        </p>
                                                    ` : ''}
                                                </div>
                                            </div>

                                            <div class="self-end sm:self-center flex-shrink-0">
                                                <span class="px-3 py-1 text-xs font-mono font-bold rounded-lg ${timeBadge} flex items-center gap-1.5">
                                                    <i data-lucide="clock" class="w-3 h-3"></i>
                                                    ${item.time}
                                                </span>
                                            </div>
                                        </div>
                                    `;
                                }).join('')}
                            </div>
                        </div>
                    </div>
                `;
            });

            container.innerHTML = html;
            lucide.createIcons();
        }

        // Accordion Toggle function (Single Open Accordion Pattern)
        function toggleDay(campus, index) {
            if (campus === 'lipia') {
                activeLipiaIndex = (activeLipiaIndex === index) ? -1 : index;
                renderAccordion('lipia');
            } else {
                activeUimIndex = (activeUimIndex === index) ? -1 : index;
                renderAccordion('uim');
            }
        }

        // Switch Campus Tab
        function switchCampus(campus) {
            currentCampus = campus;
            const btnLipia = document.getElementById('btnLipia');
            const btnUim = document.getElementById('btnUim');
            const pageLipia = document.getElementById('pageLipia');
            const pageUim = document.getElementById('pageUim');
            const segmentedBg = document.getElementById('segmentedBg');

            if (campus === 'lipia') {
                segmentedBg.style.left = '4px';
                btnLipia.className = "relative z-10 w-1/2 py-2.5 text-xs sm:text-sm font-bold rounded-full transition-colors duration-300 text-slate-900 dark:text-white flex items-center justify-center gap-2";
                btnUim.className = "relative z-10 w-1/2 py-2.5 text-xs sm:text-sm font-bold rounded-full transition-colors duration-300 text-slate-500 dark:text-slate-400 hover:text-slate-900 dark:hover:text-white flex items-center justify-center gap-2";

                pageUim.classList.add('opacity-0');
                setTimeout(() => {
                    pageUim.classList.add('hidden');
                    pageLipia.classList.remove('hidden');
                    setTimeout(() => pageLipia.classList.remove('opacity-0'), 20);
                }, 200);
            } else {
                segmentedBg.style.left = 'calc(50%)';
                btnUim.className = "relative z-10 w-1/2 py-2.5 text-xs sm:text-sm font-bold rounded-full transition-colors duration-300 text-slate-900 dark:text-white flex items-center justify-center gap-2";
                btnLipia.className = "relative z-10 w-1/2 py-2.5 text-xs sm:text-sm font-bold rounded-full transition-colors duration-300 text-slate-500 dark:text-slate-400 hover:text-slate-900 dark:hover:text-white flex items-center justify-center gap-2";

                pageLipia.classList.add('opacity-0');
                setTimeout(() => {
                    pageLipia.classList.add('hidden');
                    pageUim.classList.remove('hidden');
                    setTimeout(() => pageUim.classList.remove('opacity-0'), 20);
                }, 200);
            }
        }

        // Dark / Light Mode Toggle
        const themeToggleBtn = document.getElementById('themeToggle');
        const themeText = document.getElementById('themeText');

        themeToggleBtn.addEventListener('click', () => {
            const html = document.documentElement;
            if (html.classList.contains('dark')) {
                html.classList.remove('dark');
                themeText.textContent = 'Light Mode';
            } else {
                html.classList.add('dark');
                themeText.textContent = 'Dark Mode';
            }
        });

        // -------------------------------------------------------------
        // ANIMATED PAC-MAN BACKGROUND CANVAS LOGIC
        // -------------------------------------------------------------
        const canvas = document.getElementById('pacmanCanvas');
        const ctx = canvas.getContext('2d');

        let width, height;
        function resizeCanvas() {
            width = canvas.width = window.innerWidth;
            height = canvas.height = window.innerHeight;
        }
        window.addEventListener('resize', resizeCanvas);
        resizeCanvas();

        class PacmanCharacter {
            constructor() {
                this.reset();
            }

            reset() {
                this.y = Math.random() * (height - 120) + 60;
                this.x = -60;
                this.speed = 1.4 + Math.random() * 0.8;
                this.radius = 16;
                this.mouthAngle = 0.2;
                this.mouthSpeed = 0.025;
                
                // Ghost Squad
                this.ghosts = [
                    { x: this.x - 45, color: '#ef4444' }, // Red (Blinky)
                    { x: this.x - 80, color: '#ec4899' }, // Pink (Pinky)
                    { x: this.x - 115, color: '#06b6d4' } // Cyan (Inky)
                ];

                // Dots line
                this.dots = [];
                for (let dx = 35; dx < width + 200; dx += 32) {
                    this.dots.push({ x: dx, eaten: false });
                }
            }

            update() {
                this.x += this.speed;
                this.ghosts.forEach(g => g.x += this.speed);

                // Mouth opening/closing
                this.mouthAngle += this.mouthSpeed;
                if (this.mouthAngle > 0.38 || this.mouthAngle < 0.03) {
                    this.mouthSpeed = -this.mouthSpeed;
                }

                // Eat dots
                this.dots.forEach(dot => {
                    if (!dot.eaten && this.x >= dot.x) {
                        dot.eaten = true;
                    }
                });

                // Reset loop
                if (this.x - 150 > width) {
                    this.reset();
                }
            }

            draw() {
                const isDark = document.documentElement.classList.contains('dark');
                const pacmanColor = isDark ? '#fbbf24' : '#d97706';
                const dotColor = isDark ? '#64748b' : '#94a3b8';

                // Draw Dots
                this.dots.forEach(dot => {
                    if (!dot.eaten && dot.x < width) {
                        ctx.beginPath();
                        ctx.arc(dot.x, this.y, 3, 0, Math.PI * 2);
                        ctx.fillStyle = dotColor;
                        ctx.fill();
                        ctx.closePath();
                    }
                });

                // Draw Pac-Man
                ctx.beginPath();
                ctx.arc(this.x, this.y, this.radius, this.mouthAngle * Math.PI, (2 - this.mouthAngle) * Math.PI);
                ctx.lineTo(this.x, this.y);
                ctx.fillStyle = pacmanColor;
                ctx.fill();
                ctx.closePath();

                // Draw Eye
                ctx.beginPath();
                ctx.arc(this.x + 2, this.y - 8, 2, 0, Math.PI * 2);
                ctx.fillStyle = '#000000';
                ctx.fill();
                ctx.closePath();

                // Draw Ghosts
                this.ghosts.forEach(ghost => {
                    if (ghost.x > -30 && ghost.x < width + 30) {
                        this.drawGhost(ghost.x, this.y, ghost.color);
                    }
                });
            }

            drawGhost(x, y, color) {
                const r = 14;
                ctx.beginPath();
                ctx.arc(x, y - 2, r, Math.PI, 0, false);
                ctx.lineTo(x + r, y + r);
                ctx.lineTo(x + r * 0.5, y + r - 3);
                ctx.lineTo(x, y + r);
                ctx.lineTo(x - r * 0.5, y + r - 3);
                ctx.lineTo(x - r, y + r);
                ctx.closePath();
                
                ctx.fillStyle = color;
                ctx.fill();

                // Eyes
                ctx.beginPath();
                ctx.arc(x - 4, y - 3, 3.5, 0, Math.PI * 2);
                ctx.arc(x + 4, y - 3, 3.5, 0, Math.PI * 2);
                ctx.fillStyle = '#ffffff';
                ctx.fill();

                // Pupils
                ctx.beginPath();
                ctx.arc(x - 2, y - 3, 1.8, 0, Math.PI * 2);
                ctx.arc(x + 6, y - 3, 1.8, 0, Math.PI * 2);
                ctx.fillStyle = '#1e293b';
                ctx.fill();
            }
        }

        const pacmanSim = new PacmanCharacter();

        function animateCanvas() {
            ctx.clearRect(0, 0, width, height);
            pacmanSim.update();
            pacmanSim.draw();
            requestAnimationFrame(animateCanvas);
        }

        // INITIALIZATION
        window.onload = () => {
            renderAccordion('lipia');
            renderAccordion('uim');
            lucide.createIcons();
            animateCanvas();
        };
    </script>
</body>
</html>
