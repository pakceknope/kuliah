                    { jam: "Sesi 2", time: "06:00 WIB", subject: "Tata Bahasa/Struktur (Tarakib)", icon: "layers" },
                    { jam: "Sesi 3", time: "07:00 WIB", subject: "Fonetik/Bunyi (Aswat)", icon: "volume-2" },
