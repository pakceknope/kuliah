        let activeLipiaIndex = 0; // Default Senin
        let activeUimIndex = 0;   // Default Minggu
        let currentCampus = 'lipia';

        // Render Accordion Function
        function renderAccordion(campus) {
            const isLipia = campus === 'lipia';
            const data = isLipia ? lipiaData : uimData;
            const activeIndex = isLipia ? activeLipiaIndex : activeUimIndex;
            const containerId = isLipia ? 'accordionLipia' : 'accordionUim';
