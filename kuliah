            const activeHeaderClass = isLipia 
                ? 'bg-blue-500/10 dark:bg-sky-500/10 text-blue-900 dark:text-sky-300 border-b border-blue-200/50 dark:border-sky-500/20' 
                : 'bg-uim-teal/10 dark:bg-uim-teal/15 text-teal-800 dark:text-uim-tealLight border-b border-uim-teal/20 dark:border-uim-teal/30';

            let html = '';

            data.forEach((dayGroup, index) => {
                const isOpen = index === activeIndex;
                const totalItems = dayGroup.items.length;

                html += `
                    <div class="ios-glass rounded-2xl overflow-hidden transition-all duration-300 shadow-xs border border-slate-200/80 dark:border-slate-800/80">
                        <!-- Accordion Header Button -->
                        <button onclick="toggleDay('${campus}', ${index})" 
                                class="w-full px-5 py-4 flex items-center justify-between text-left transition-all duration-200 ${isOpen ? activeHeaderClass : 'hover:bg-slate-200/40 dark:hover:bg-slate-800/40'}">
